# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG điền key thật vào file này (file này được commit).

# Gemini (Tuần 2: chatbot ở trang chủ). Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Supabase (Tuần 3: database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
